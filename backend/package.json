{
  "name": "ticko-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Ticko - real-time ISP service operations backend",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "demo:traffic": "tsx scripts/demo-traffic.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prisma": "6.19.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8",
    "@prisma/adapter-pg": "6.19.0",
    "pg": "^8.13.1",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0",
    "express-rate-limit": "^7.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ws": "^8.5.13",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}