# ---- Copy to backend/.env for local (non-Docker) development ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tixory:tixory@localhost:5432/tixoryops?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
BCRYPT_COST=12

# HTTP
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true

# Business configuration
MAX_ACTIVE_TICKETS=2        # default active-ticket cap per technician (BR-02)
VERIFY_PASS_THRESHOLD=0.8   # measured/plan speed ratio needed to pass verification
AUTO_CLOSE_HOURS=48         # auto-close RESOLVED tickets after this (simulated) silence

# Concurrency & simulation
WORKER_CONCURRENCY=3        # parallel background jobs
PROBE_STAGE_MS=2500         # how long each simulated remote check "takes" (real ms)
SCHEDULER_TICK_MS=1000      # SLA / overrun scanner interval
DEMO_MODE=true              # enables PASS/FAIL verification overrides in production builds

# Time scale for HUMAN work durations (steps, SLA): 1 = real time,
# 60 = one real second counts as one simulated minute (great for live demos)
DEMO_TIME_SCALE=1

# Tests (optional override)
# TEST_DATABASE_URL=postgresql://tixory:tixory@localhost:5432/tixoryops_test?schema=public
